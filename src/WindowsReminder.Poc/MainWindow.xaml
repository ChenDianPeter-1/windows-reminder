<Window x:Class="WindowsReminder.Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Reminder POC" Height="200" Width="400"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock Text="🔔 Windows Reminder POC" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock x:Name="StatusText" Text="Toast sent. Click 'Done' on the notification..." FontSize="14" TextWrapping="Wrap"/>
        <TextBlock x:Name="ResultText" Margin="0,20,0,0" FontSize="14" FontWeight="Bold" Foreground="Gray"/>
    </StackPanel>
</Window>
